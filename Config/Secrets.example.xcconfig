// Copy this file to Config/Secrets.xcconfig and fill it in. Secrets.xcconfig is ignored by git.

// Apple developer team ID (Xcode > Settings > Accounts) and a bundle ID of your own.
DEVELOPMENT_TEAM =
PRODUCT_BUNDLE_IDENTIFIER = com.example.topooffline

// LINZ Basemaps API key for the New Zealand topo map. A standard key (valid 90 days) is shown on
// https://basemaps.linz.govt.nz; apps should request a developer key from basemaps@linz.govt.nz.
// Leave empty to hide the NZ topo map (DOC tracks, huts and NZ search still work).
LINZ_API_KEY =
LINZ_KEY_IS_DEVELOPER = NO
